{
  "name": "step-function-viewer-light",
  "displayName": "Step Function Viewer Light",
  "description": "Interactive viewer for AWS Step Functions (JSONata) with per-state variable inspection and cross-state variable highlighting.",
  "version": "0.1.5",
  "publisher": "RobertoRiquelmeSaez",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rriquelme/step-function-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/rriquelme/step-function-viewer/issues"
  },
  "homepage": "https://github.com/rriquelme/step-function-viewer#readme",
  "galleryBanner": {
    "color": "#1e2330",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "aws",
    "step functions",
    "state machine",
    "asl",
    "jsonata"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "stepFunctionViewer.editor",
        "displayName": "Step Function Viewer Light",
        "selector": [
          {
            "filenamePattern": "*.asl.json"
          },
          {
            "filenamePattern": "*.asl"
          },
          {
            "filenamePattern": "*.asl.yaml"
          },
          {
            "filenamePattern": "*.asl.yml"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "stepFunctionViewer.open",
        "title": "Open Step Function Viewer Light",
        "category": "Step Functions"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "stepFunctionViewer.open",
          "when": "resourceLangId == json || resourceLangId == yaml || resourceExtname == .asl"
        }
      ],
      "editor/title": [
        {
          "command": "stepFunctionViewer.open",
          "when": "resourceLangId == json || resourceLangId == yaml || resourceExtname == .asl",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Step Function Viewer Light",
      "properties": {
        "stepFunctionViewer.layoutDirection": {
          "type": "string",
          "enum": [
            "TB",
            "LR"
          ],
          "default": "TB",
          "description": "Graph layout direction: top-to-bottom (TB) or left-to-right (LR)."
        },
        "stepFunctionViewer.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open the viewer when an ASL file is opened."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile-tests": "tsc -p tsconfig.test.json",
    "pretest:integration": "npm run compile-tests && npm run build",
    "test:integration": "vscode-test",
    "make-icon": "node scripts/make-icon.mjs",
    "package": "vsce package",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^2.31.0",
    "esbuild": "^0.23.0",
    "eslint": "^9.9.0",
    "jsdom": "^24.1.0",
    "mocha": "^10.7.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
